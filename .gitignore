# Git ignore for CampusLedger – Student Management System
# Author: Ranodeep Malik

# ── Build output ──────────────────────────────────────────────────────────────
target/
*.class
*.jar
*.war

# ── IDE-specific files ───────────────────────────────────────────────────────
.idea/
*.iml
.project
.classpath
.settings/
*.swp

# ── Local config with real credentials ───────────────────────────────────────
# This file is generated from application-local.properties.example
src/main/resources/application-local.properties
application-local.properties

# Environment variable files
.env
.env.local

# ── Maven wrapper cache ───────────────────────────────────────────────────────
.mvn/wrapper/maven-wrapper.jar

# ── OS-generated files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Log files ─────────────────────────────────────────────────────────────────
*.log
logs/
